{
  "name": "estu-eem-planner",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "esbuild tests/engine.test.ts --bundle --platform=node --format=esm --outfile=.test-build/engine.mjs --external:pdfjs-dist --log-level=warning && node .test-build/engine.mjs",
    "test:schedule": "esbuild tests/schedule-corpus.test.ts --bundle --platform=node --format=esm --outfile=.test-build/schedule.mjs --external:pdfjs-dist --log-level=warning && node .test-build/schedule.mjs",
    "build:profiles": "node scripts/build-department-profile.mjs",
    "deploy": "npm run build && gh-pages -d dist",
    "test:transcript": "esbuild tests/transcript-corpus.test.ts --bundle --platform=node --format=esm --outfile=.test-build/transcript.mjs --external:pdfjs-dist --log-level=warning && node .test-build/transcript.mjs",
    "test:recall": "esbuild tests/schedule-recall.test.ts --bundle --platform=node --format=esm --outfile=.test-build/recall.mjs --external:pdfjs-dist --log-level=warning && node .test-build/recall.mjs"
  },
  "dependencies": {
    "jspdf": "^4.0.0",
    "lucide-react": "^0.263.1",
    "pdfjs-dist": "^5.4.530",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "gh-pages": "^6.1.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
